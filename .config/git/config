[core]
	commentchar = ";"
[init]
	defaultBranch = main
[pull]
	rebase = true
[rebase]
	autoStash = true
[alias]
  ac = commit -am
  amend = commit -a --amend --no-edit
  prune-branches = !git remote prune origin && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -d
  prune-branches-f = !git remote prune origin && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -D
  push-f = push --force-with-lease
  recommit = "!f() { test -n \"$1\" || { echo 'Usage: git recommit <upstream>'; return 1; }; git rebase \"$1\" --exec 'git commit --amend --no-edit'; }; f"
[push]
  autoSetupRemote = true
[rerere]
  enabled = true
[branch]
  sort = -committerdate
[commit]
  gpgsign = true
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers
  defaultKeyCommand = ssh-add -L
